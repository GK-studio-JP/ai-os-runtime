{
  "schema": "ai-os-process:v1",
  "id": "PROC-RUNTIME",
  "name": "runtime",
  "repository": "GK-studio-JP/ai-os-runtime",
  "responsibility": [
    "worker preflight",
    "provider-neutral compute invocation",
    "worker result normalization",
    "postflight freshness gate",
    "canonical event proposal generation"
  ],
  "excludes": [
    "task scheduling policy",
    "capability grants",
    "canonical persistence authority",
    "subsystem implementation decisions"
  ],
  "consumes": [
    "ai-os-worker-boot:v1",
    "ai-os-context-capsule:v1",
    "ai-os-kernel-dispatch-validation:v1",
    "ai-bb:v1 replay"
  ],
  "provides": [
    "ai-os-runtime-preflight:v1",
    "ai-os-worker-invocation:v1",
    "ai-os-runtime-outcome:v1",
    "ai-os-runtime-gate:v1"
  ]
}
